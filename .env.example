# ALI runtime
ALI_ENV=development
ALI_LOG_LEVEL=INFO
ALI_DATABASE_URL=sqlite:///./data/ali.db
ALI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALI_TIMEZONE=Europe/Madrid
ALI_QUIET_HOURS_START=23
ALI_QUIET_HOURS_END=7

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ENABLED=false
# Set these only after finding the real Home Assistant entity IDs.
HOME_ASSISTANT_COVER_ENTITY_ID=
HOME_ASSISTANT_CLIMATE_ENTITY_ID=

# OpenAI: text reasoning only by default. Never expose this key to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=false
OPENAI_MONTHLY_LIMIT=0.50
OPENAI_DAILY_LIMIT=0.03
OPENAI_SOFT_MONTHLY_WARNING=0.35
OPENAI_INPUT_COST_PER_1M=0.15
OPENAI_OUTPUT_COST_PER_1M=0.60
OPENAI_MAX_OUTPUT_TOKENS=120

# Live Context: only used when the phrase needs fresh public information.
# Example: "estoy viendo el Barça" -> check current match before answering.
OPENAI_LIVE_CONTEXT_ENABLED=true
OPENAI_LIVE_MODEL=gpt-4o-mini
# Conservative configurable estimate for one web-search tool call.
OPENAI_WEB_SEARCH_COST_PER_CALL=0.01

# Local voice: default path. No OpenAI transcription charge.
ALI_LOCAL_STT_ENABLED=true
ALI_LOCAL_STT_MODEL=small
ALI_LOCAL_STT_DEVICE=cpu
ALI_LOCAL_STT_COMPUTE_TYPE=int8
ALI_SPEAKER_ID_ENABLED=true
ALI_SPEAKER_MODEL=speechbrain/spkrec-ecapa-voxceleb
ALI_SPEAKER_THRESHOLD=0.62
ALI_VOICE_MODEL_CACHE=/app/data/models

# Paid cloud voice remains OFF and is only a fallback if explicitly enabled.
OPENAI_VOICE_ENABLED=false
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_COST_PER_MINUTE=0.003
OPENAI_TTS_ENABLED=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=1.2
OPENAI_TTS_ESTIMATED_COST_PER_MINUTE=0.015
ALI_VOICE_MAX_BYTES=4000000
ALI_VOICE_MAX_SECONDS=8
ALI_VOICE_MAX_REPLY_CHARS=180

# Voice defaults
ALI_WAKE_WORD=ALI
ALI_LANGUAGE=es
