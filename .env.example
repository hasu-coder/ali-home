# ALI runtime
ALI_ENV=development
ALI_LOG_LEVEL=INFO
ALI_DATABASE_URL=sqlite:///./data/ali.db
ALI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ENABLED=false

# OpenAI: never expose this key to the frontend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ENABLED=false
OPENAI_MONTHLY_LIMIT=2.00
OPENAI_DAILY_LIMIT=0.10
OPENAI_SOFT_MONTHLY_WARNING=1.00

# Cost estimation defaults. Adjust when model pricing changes.
OPENAI_INPUT_COST_PER_1M=0.40
OPENAI_OUTPUT_COST_PER_1M=1.60

# Voice: the microphone reaches OpenAI only through the backend; the key is never sent to the browser.
# Keep text reasoning and premium TTS off until you decide to enable them.
OPENAI_VOICE_ENABLED=false
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_COST_PER_MINUTE=0.003
OPENAI_TTS_ENABLED=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_ESTIMATED_COST_PER_MINUTE=0.015
ALI_VOICE_MAX_BYTES=4000000
ALI_VOICE_MAX_SECONDS=20
ALI_VOICE_MAX_REPLY_CHARS=480

# Voice defaults
ALI_WAKE_WORD=ALI
ALI_LANGUAGE=es
