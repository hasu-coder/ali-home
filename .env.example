# ALI runtime
ALI_ENV=development
ALI_LOG_LEVEL=INFO
ALI_DATABASE_URL=sqlite:///./data/ali.db
ALI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Home Assistant
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ENABLED=false

# OpenAI: never expose this key to the frontend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_ENABLED=false
OPENAI_MONTHLY_LIMIT=5.00
OPENAI_DAILY_LIMIT=1.00
OPENAI_SOFT_MONTHLY_WARNING=2.00

# Cost estimation defaults. Adjust when model pricing changes.
OPENAI_INPUT_COST_PER_1M=0.40
OPENAI_OUTPUT_COST_PER_1M=1.60

# Voice placeholders for later phases
ALI_WAKE_WORD=ALI
ALI_LANGUAGE=es
